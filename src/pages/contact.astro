---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout
  title="Contact & Devis Gratuit | Plombier Wavre Urgent (1300)"
  description="Contactez votre artisan plombier à Wavre : appel direct 24h/24 au 0489 86 57 65 ou formulaire de devis gratuit en ligne. Réponse en 15 minutes."
>

  <!-- Page Header -->
  <section class="bg-[#123470] text-white py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="text-xs font-extrabold uppercase tracking-widest text-[#fcd400] bg-white/10 px-3.5 py-1.5 rounded-full inline-block">
        Assistance Rapide & Devis
      </span>
      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight">
        Contactez Notre Équipe à Wavre
      </h1>
      <p class="text-base sm:text-lg text-white/80 max-w-2xl mx-auto font-normal">
        Pour une urgence immédiate, privilégiez l'appel téléphonique direct. Pour un projet de rénovation ou un devis sans urgence, remplissez le formulaire ci-dessous.
      </p>
    </div>
  </section>

  <!-- Main Contact Section -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- Left Column: Contact Cards & Direct Hotline -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Urgent Hotline Card -->
          <div class="bg-[#0047ab] text-white rounded-3xl p-8 shadow-xl space-y-5 border border-white/10">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-xs font-bold text-[#fcd400]">
              <span class="w-2 h-2 rounded-full bg-[#059669] animate-pulse"></span>
              <span>Ligne d'Urgence Active 24h/24</span>
            </div>
            
            <div class="space-y-1">
              <span class="text-xs text-white/70 uppercase tracking-wider block">
                Permanence téléphonique immédiate :
              </span>
              <a
                href="tel:0489865765"
                class="font-display font-extrabold text-3xl sm:text-4xl text-white hover:text-[#fcd400] transition-colors block tabular-nums"
              >
                0489 86 57 65
              </a>
            </div>

            <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
              En cas d'inondation ou de canalisation rompue, appelez immédiatement. Notre artisan d'astreinte vous guide sur les premiers gestes (fermeture du compteur général) pendant son trajet vers votre domicile.
            </p>

            <div class="pt-2 flex flex-col sm:flex-row gap-3">
              <a
                href="tel:0489865765"
                class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-[#fcd400] text-[#101d29] font-display font-bold text-sm hover:bg-[#e9c400] shadow-sm transition-all"
              >
                <Icon name="phone" class="w-4 h-4 text-[#00327d]" />
                <span>Appeler maintenant</span>
              </a>
              <a
                href="https://wa.me/32489865765?text=Bonjour,%20j%27ai%20une%20urgence%20plomberie%20%C3%A0%20Wavre"
                class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-[#059669] text-white font-display font-bold text-sm hover:bg-[#047857] shadow-sm transition-all"
              >
                <Icon name="whatsapp" class="w-4 h-4 text-white" />
                <span>WhatsApp Photo</span>
              </a>
            </div>
          </div>

          <!-- Physical Information Card -->
          <div class="bg-white rounded-3xl p-8 border border-[#e4eaf1] shadow-xs space-y-6">
            <h2 class="font-display font-bold text-xl text-[#00327d]">
              Coordonnées de l'Atelier
            </h2>

            <div class="space-y-4 text-sm text-[#434653]">
              <div class="flex items-start gap-3">
                <Icon name="map-pin" class="w-5 h-5 text-[#0047ab] shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-[#101d29] block">Adresse d'exploitation :</span>
                  <a
                    href="https://maps.app.goo.gl/oCBeEPNkZFPVsKrB9"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-[#0047ab] hover:underline font-medium"
                  >
                    Rue Charles Jaumotte 76, 1300 Wavre
                  </a>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Icon name="clock" class="w-5 h-5 text-[#0047ab] shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-[#101d29] block">Horaires du service :</span>
                  <span>Dépannage d'urgence : 24h/24 et 7j/7</span>
                  <span class="block text-xs text-[#705d00] mt-0.5">Bureau & devis : Lundi au Vendredi 08h00 à 18h30</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Icon name="file-text" class="w-5 h-5 text-[#0047ab] shrink-0 mt-0.5" />
                <div>
                  <span class="font-bold text-[#101d29] block">Identification d'entreprise :</span>
                  <span>BCE : BE 0849.281.930 | Cerga H-39184</span>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-[#e4eaf1] bg-[#edf4ff] p-4 rounded-xl">
              <span class="text-xs font-bold text-[#00327d] block mb-1">
                Engagement de réponse rapide
              </span>
              <p class="text-xs text-[#434653]">
                Toute demande de devis transmise via notre formulaire en ligne reçoit une proposition sous 15 minutes en journée.
              </p>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Quote Form -->
        <div class="lg:col-span-7">
          <div class="bg-white rounded-3xl p-8 sm:p-10 border border-[#e4eaf1] shadow-md space-y-6">
            
            <div class="border-b border-[#e4eaf1] pb-4">
              <span class="text-xs font-bold text-[#0047ab] uppercase tracking-wider block">
                Formulaire Sans Engagement
              </span>
              <h2 class="font-display font-extrabold text-2xl text-[#101d29]">
                Demande de Devis ou Rendez-Vous
              </h2>
            </div>

            <form
              id="contact-form"
              action="https://formsubmit.co/midebzn@gmail.com"
              method="POST"
              class="space-y-5"
            >
              <input type="hidden" name="_subject" value="Demande de Devis Contact - Plombier Wavre Urgent" />
              <input type="hidden" name="_captcha" value="false" />
              <input type="hidden" name="_template" value="table" />
              <input type="hidden" name="_next" value="https://plombier-wavre-urgent.vercel.app/contact?succes=1" />
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="name" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Nom et Prénom *
                  </label>
                  <input
                    type="text"
                    id="name"
                    name="nom_prenom"
                    required
                    placeholder="Jean Dupont"
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  />
                </div>

                <div class="space-y-1.5">
                  <label for="phone" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Numéro de Téléphone *
                  </label>
                  <input
                    type="tel"
                    id="phone"
                    name="telephone"
                    required
                    placeholder="0470 12 34 56"
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="email" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Adresse Email *
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="j.dupont@exemple.be"
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  />
                </div>

                <div class="space-y-1.5">
                  <label for="location" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Localité d'intervention *
                  </label>
                  <select
                    id="location"
                    name="commune"
                    required
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  >
                    <option value="Wavre 1300">Wavre Centre (1300)</option>
                    <option value="Limal 1300">Limal (1300)</option>
                    <option value="Bierges 1301">Bierges (1301)</option>
                    <option value="Basse-Wavre">Basse-Wavre</option>
                    <option value="Ottignies-LLN">Ottignies - Louvain-la-Neuve</option>
                    <option value="Rixensart">Rixensart / Genval</option>
                    <option value="Grez-Doiceau">Grez-Doiceau</option>
                    <option value="Chaumont-Gistoux">Chaumont-Gistoux</option>
                    <option value="Autre commune">Autre commune en Brabant Wallon</option>
                  </select>
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1.5">
                  <label for="urgency" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Degré d'urgence *
                  </label>
                  <select
                    id="urgency"
                    name="degre_urgence"
                    required
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  >
                    <option value="Urgence immédiate">Urgence immédiate (Arrivée 30 min)</option>
                    <option value="Aujourd'hui">Dans la journée</option>
                    <option value="Dans la semaine">Dans la semaine</option>
                    <option value="Projet de rénovation">Projet planifié (devis travaux)</option>
                  </select>
                </div>

                <div class="space-y-1.5">
                  <label for="service-type" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                    Type de problème ou prestation
                  </label>
                  <select
                    id="service-type"
                    name="prestation"
                    class="w-full h-12 px-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                  >
                    <option value="Fuite d'eau">Fuite d'eau (tuyau, vanne, évier)</option>
                    <option value="Débouchage WC ou évier">Débouchage WC, douche, sterput</option>
                    <option value="Panne boiler / chauffe-eau">Panne boiler ou eau froide</option>
                    <option value="Détartrage boiler">Détartrage cuve chauffe-eau</option>
                    <option value="Adoucisseur d'eau">Installation ou entretien adoucisseur</option>
                    <option value="Recherche de fuite">Recherche de fuite non destructive</option>
                    <option value="Rénovation sanitaire">Rénovation salle de bain / WC suspendu</option>
                    <option value="Autre">Autre demande</option>
                  </select>
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="message" class="text-xs font-bold text-[#101d29] uppercase tracking-wide">
                  Détails de la situation
                </label>
                <textarea
                  id="message"
                  name="message_details"
                  rows="4"
                  placeholder="Décrivez brièvement le problème (symptômes, pièce concernée, marque de l'appareil...)"
                  class="w-full p-4 rounded-xl border border-[#e4eaf1] bg-[#f7f9ff] text-sm text-[#101d29] focus:bg-white focus:border-[#0047ab] focus:outline-none transition-colors"
                ></textarea>
              </div>

              <div class="flex items-center gap-2 pt-1 text-xs text-[#434653]">
                <Icon name="shield" class="w-4 h-4 text-[#059669] shrink-0" />
                <span>Vos données restent confidentielles et ne sont jamais transmises à des tiers.</span>
              </div>

              <button
                type="submit"
                id="submit-btn"
                class="w-full py-4 px-6 rounded-xl bg-[#0047ab] hover:bg-[#00327d] text-white font-display font-extrabold text-base shadow-md transition-all active:scale-[0.98]"
              >
                Envoyer ma demande de devis gratuit
              </button>

            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>
