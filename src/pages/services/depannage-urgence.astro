---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const includes = [
  "Déplacement d'urgence en 30 minutes sur Wavre (1300), Limal et Bierges (1301)",
  "Coupure et sécurisation immédiate du réseau d'alimentation d'eau",
  "Diagnostic précis de l'origine de la fuite ou de la rupture de conduite",
  "Réparation ou remplacement de tronçons de tuyauterie (cuivre, multiskin, PVC)",
  "Remplacement de vannes d'arrêt principales grippées ou fuyardes",
  "Colmatage d'urgence sous évier, baignoire, douche ou WC",
  "Nettoyage et évacuation des eaux stagnantes après coupure",
  "Facture détaillée avec mention d'urgence certifiée pour votre assurance habitation"
];

const problems = [
  {
    title: "Tuyau percé ou canalisation rompue",
    desc: "Jet d'eau sous pression dans les cloisons ou le sol. Nous coupons l'arrivée d'eau et remplaçons le segment détérioré sur-le-champ."
  },
  {
    title: "Vanne d'arrêt principale cassée ou bloquée",
    desc: "Impossible de couper l'eau lors d'une fuite. Nous disposons de pinces de congélation de tuyauterie pour intervenir sans couper tout l'immeuble."
  },
  {
    title: "Inondation sous évier ou meuble de cuisine",
    desc: "Flexibles d'alimentation arrachés, raccordement déboîté ou siphon fissuré inondant vos meubles et votre parquet."
  },
  {
    title: "Fuite continue au groupe de sécurité",
    desc: "Écoulement abondant et continu sur votre ballon d'eau chaude risquant la surpression ou la rupture de cuve."
  },
  {
    title: "WC suspendu ou classique qui déborde",
    desc: "Flotteur défaillant combiné à une évacuation obstruée créant un risque de débordement immédiat des eaux usées."
  },
  {
    title: "Infiltration d'eau au plafond de l'étage inférieur",
    desc: "Tache d'humidité grandissante ou gouttes traversant le plafond depuis la salle de bain de l'étage."
  }
];

const steps = [
  {
    num: "1",
    title: "Appel & Conseil d'Urgence",
    desc: "Dès votre appel au 010 39 50 10, nous vous guidons pour fermer la vanne d'arrêt la plus proche et limiter les dégâts d'eau pendant le trajet de l'artisan."
  },
  {
    num: "2",
    title: "Arrivée sous 30 Minutes",
    desc: "Nos techniciens d'astreinte basés à Wavre arrivent avec tout le stock de raccords et tubes nécessaires pour réparer sans aller-retour inutile."
  },
  {
    num: "3",
    title: "Devis Ferme & Réparation",
    desc: "Le technicien inspecte la panne, vous annonce le tarif forfaitaire exact, et procède immédiatement à la réparation après votre accord."
  },
  {
    num: "4",
    title: "Contrôle & Attestation Assurance",
    desc: "Mise sous pression du circuit, vérification d'étanchéité au manomètre, et remise d'une facture détaillée pour votre compagnie d'assurance."
  }
];

const faqs = [
  {
    q: "Dans quel délai pouvez-vous être chez moi à Wavre ?",
    a: "Notre délai moyen constaté sur l'entité de Wavre (Wavre Centre 1300, Limal 1300 et Bierges 1301) est de 20 à 35 minutes. Nous privilégions les axes directs via la N4 et la E411."
  },
  {
    q: "Intervenez-vous la nuit, le dimanche et les jours fériés ?",
    a: "Oui. Nous maintenons une équipe d'astreinte 24h/24 et 7j/7, 365 jours par an, pour répondre à toute situation d'inondation ou de panne d'eau critique."
  },
  {
    q: "Le dépannage est-il remboursé par mon assurance habitation en Belgique ?",
    a: "Dans la majorité des cas de dégât des eaux imprévu (rupture de flexible, gel, fuite après compteur), l'assurance habitation couvre les dommages et la recherche de fuite. Nous vous fournissons la facture conforme demandée par AXA, AG, Ethias ou Baloise."
  },
  {
    q: "Combien coûte un dépannage plomberie d'urgence à Wavre ?",
    a: "Notre forfait déplacement et diagnostic à Wavre commence à 65 €. Si une réparation immédiate est possible, le coût total des pièces et de la main-d'œuvre vous est communiqué avant toute intervention."
  }
];
---

<Layout
  title="Dépannage Plomberie d'Urgence à Wavre (1300) | 24/7 en 30 Min"
  description="Dépannage plomberie d'urgence 24h/24 et 7j/7 à Wavre (1300), Limal, Bierges. Fuite d'eau, canalisation rompue, inondation. Arrivée en 30 min. Tél : 010 39 50 10."
>

  <!-- Hero Banner -->
  <section class="bg-[#123470] text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="flex items-center gap-2 text-xs font-bold text-white/70">
        <a href="/" class="hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/services" class="hover:text-white">Services</a>
        <span>/</span>
        <span class="text-[#fcd400]">Dépannage d'Urgence</span>
      </div>

      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#fcd400] text-[#101d29] text-xs font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-[#059669] animate-pulse"></span>
        <span>Astreinte active 24h/24 - Arrivée en 30 minutes</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight max-w-4xl">
        Dépannage Plomberie d'Urgence à Wavre (1300) et Brabant Wallon
      </h1>

      <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
        Une fuite d'eau incontrôlable ? Une canalisation qui cède ? Nos artisans plombiers d'urgence se déplacent en 30 minutes chrono sur Wavre, Limal et Bierges pour sécuriser votre domicile et réparer l'installation.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href="tel:010395010"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95"
        >
          <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
          <span>Appel Urgence : 010 39 50 10</span>
        </a>
        <a
          href="https://wa.me/3210395010?text=Bonjour,%20j%27ai%20une%20urgence%20plomberie%20%C3%A0%20Wavre"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-[#059669] hover:bg-[#047857] text-white font-display font-bold text-sm shadow-md transition-all"
        >
          <Icon name="whatsapp" class="w-5 h-5" />
          <span>Envoyer photo de la fuite</span>
        </a>
      </div>

    </div>
  </section>

  <!-- What's Included -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Détail de la Prestation
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Ce Qui Est Inclus dans Notre Dépannage d'Urgence
        </h2>
        <p class="text-base text-[#434653]">
          Chaque intervention d'urgence est encadrée par un protocole technique strict pour stopper le sinistre et éviter toute récidive.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {includes.map((item) => (
          <div class="flex items-start gap-3 p-4 rounded-xl bg-[#f7f9ff] border border-[#e4eaf1]">
            <div class="w-6 h-6 rounded-full bg-[#059669]/10 text-[#059669] flex items-center justify-center shrink-0 mt-0.5">
              <Icon name="check" class="w-4 h-4 text-[#059669]" />
            </div>
            <span class="text-sm text-[#101d29] font-medium leading-relaxed">{item}</span>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Common Problems Solved -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#705d00] bg-[#fcd400]/20 px-3.5 py-1.5 rounded-full inline-block">
          Situations Fréquentes
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Les Pannes et Urgences Que Nous Résolvons au Quotidien
        </h2>
        <p class="text-base text-[#434653]">
          Voici les pannes les plus courantes pour lesquelles nous sommes appelés à Wavre, Limal et Bierges.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {problems.map((p) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-[#edf4ff] text-[#0047ab] flex items-center justify-center">
              <Icon name="alert" class="w-5 h-5 text-[#ba1a1a]" />
            </div>
            <h3 class="font-display font-bold text-base text-[#101d29]">
              {p.title}
            </h3>
            <p class="text-xs sm:text-sm text-[#434653] leading-relaxed">
              {p.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Our Step-by-Step Process -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Processus d'Intervention
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Notre Protocole de Dépannage Étape par Étape
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        {steps.map((s) => (
          <div class="bg-[#f7f9ff] p-6 rounded-2xl border border-[#e4eaf1] space-y-3 relative">
            <span class="font-display font-extrabold text-3xl text-[#00327d] block tabular-nums">
              0{s.num}
            </span>
            <h3 class="font-display font-bold text-base text-[#101d29]">
              {s.title}
            </h3>
            <p class="text-xs text-[#434653] leading-relaxed">
              {s.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Why Choose Us & Service Areas -->
  <section class="py-16 sm:py-24 bg-[#123470] text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-extrabold uppercase tracking-widest text-[#fcd400] bg-white/10 px-3.5 py-1.5 rounded-full inline-block">
            Avantages Compétitifs
          </span>
          <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-white tracking-tight">
            Pourquoi Choisir Plombier Wavre Urgent ?
          </h2>
          <div class="space-y-4 text-sm text-white/80 leading-relaxed font-normal">
            <p>
              Contrairement aux plateformes d'intermédiation qui sous-traitent à des inconnus sans qualification, nous sommes de véritables artisans installés à Wavre même.
            </p>
            <ul class="space-y-3 pt-2">
              <li class="flex items-center gap-3">
                <Icon name="check" class="w-5 h-5 text-[#fcd400] shrink-0" />
                <span>Véritable permanence 24h/24 sans plateforme vocale automatisée</span>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="check" class="w-5 h-5 text-[#fcd400] shrink-0" />
                <span>Matériel et raccords de marque (Geberit, Grohe, Comap, Viega) dans le véhicule</span>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="check" class="w-5 h-5 text-[#fcd400] shrink-0" />
                <span>Agrément officiel Cerga Gaz et partenaires assurances belges</span>
              </li>
              <li class="flex items-center gap-3">
                <Icon name="check" class="w-5 h-5 text-[#fcd400] shrink-0" />
                <span>Tarifs annoncés au téléphone et validés par écrit sur place</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="lg:col-span-5 bg-white/10 rounded-3xl p-8 border border-white/10 space-y-5">
          <h3 class="font-display font-bold text-xl text-white">
            Périmètre d'Intervention Garanti
          </h3>
          <p class="text-xs sm:text-sm text-white/80 leading-relaxed">
            Nous intervenons en moins de 30 minutes dans les secteurs suivants du Brabant Wallon :
          </p>
          <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Wavre Centre (1300)</span>
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Limal (1300)</span>
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Bierges (1301)</span>
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Basse-Wavre</span>
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Ottignies-LLN (1348)</span>
            <span class="bg-white/10 p-2.5 rounded-lg text-white">Rixensart (1330)</span>
          </div>
          <div class="pt-2">
            <a
              href="tel:010395010"
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-[#fcd400] text-[#101d29] font-display font-bold text-sm hover:bg-[#e9c400] shadow-sm transition-all"
            >
              <Icon name="phone" class="w-4 h-4 text-[#00327d]" />
              <span>Demander une intervention d'urgence</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQs Section -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Vos Questions
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Questions Fréquentes sur le Dépannage d'Urgence
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-2">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {f.q}
            </h3>
            <p class="text-sm text-[#434653] leading-relaxed">
              {f.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>
