---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const neighborhoods = [
  { name: "Chaumont & Gistoux Centre", desc: "Commerces, écoles et habitations : dépannage sanitaire d'urgence, débouchage de WC, recherche de fuite et remplacement de chauffe-eau." },
  { name: "Dion-Valmont (Dion-le-Val & Dion-le-Mont)", desc: "Proximité directe de Wavre : réglage de réducteurs de pression (souvent >6 bars), protection anti-bélier et détartrage de boilers." },
  { name: "Bonlez", desc: "Propriétés calmes et vallonnées : entretien de canalisations extérieures, curage d'égouts privatifs et pose d'adoucisseurs d'eau économiques." },
  { name: "Corroy-le-Grand & Longueville", desc: "Villages et fermettes rénovées : maintenance de chaudières gaz à condensation, assainissement et débouchage d'évacuation par caméra." }
];

const directions = [
  {
    from: "Depuis le Rond-Point de Dion-Valmont",
    route: "Prendre directement la Chaussée de Huy (N243) vers Wavre Centre. Temps d'intervention : 6 à 8 minutes (environ 4.5 km)."
  },
  {
    from: "Depuis l'Église de Chaumont-Gistoux (Rue Colleau)",
    route: "Rejoindre la Chaussée de Huy via la Rue du Village vers le nord en direction de Wavre. Temps d'intervention : 9 à 11 minutes (environ 6.5 km)."
  },
  {
    from: "Depuis l'accès N25 (Sortie Chaumont-Gistoux)",
    route: "Emprunter la N25 vers le nord puis rejoindre immédiatement l'E411 ou le centre de Wavre. Trajet direct en moins de 8 minutes."
  }
];

const comparison = [
  {
    feature: "Délai d'arrivée à Chaumont-Gistoux (1325)",
    us: "20 à 30 minutes garanties",
    competitorA: "48h minimum (Heat-me)",
    competitorB: "Délais non garantis en zone rurale"
  },
  {
    feature: "Gestion de la Surpression (>6 bars)",
    us: "Réducteurs de pression industriels en stock véhicule",
    competitorA: "Pièces à commander sous plusieurs jours",
    competitorB: "Diagnostic souvent erroné sans manomètre"
  },
  {
    feature: "Spécialisation Calcaire Chaumont",
    us: "Partenaire BWT & Durlem avec paramétrage précis",
    competitorA: "Appareils bas de gamme sans SAV local",
    competitorB: "Détartrage sans neutralisation acide"
  },
  {
    feature: "Permanence 24/7 Nuit et Dimanche",
    us: "Astreinte réelle avec technicien de garde",
    competitorA: "Serveur vocal fermé le week-end",
    competitorB: "Interventions suspendues après 18h"
  },
  {
    feature: "Agrément Cerga & Démarches Assurances",
    us: "Certifié Cerga Gaz H-39184 et factures détaillées",
    competitorA: "Sous-traitance sans traçabilité",
    competitorB: "Devis souvent manquant avant démarrage"
  }
];

const faqs = [
  {
    q: "Pourquoi la pression de l'eau est-elle si forte à Dion-Valmont et Chaumont-Gistoux ?",
    a: "En raison du dénivelé entre les châteaux d'eau de la région et les vallées du Train et de la Pisselet, le réseau de distribution de l'inBW peut atteindre plus de 6 à 7 bars de pression au compteur. Sans réducteur de pression de qualité, vos robinets fuient et le groupe de sécurité du chauffe-eau coule en permanence."
  },
  {
    q: "Quelle est la dureté de l'eau à Chaumont-Gistoux (1325) ?",
    a: "La dureté de l'eau à Chaumont-Gistoux avoisine les 33 à 35 degrés français. L'installation d'un adoucisseur permet d'éliminer les dépôts blancs sur les parois de douche et de préserver vos équipements électroménagers."
  },
  {
    q: "Intervenez-vous pour un débouchage d'égout un dimanche à Bonlez ?",
    a: "Oui. Notre permanence d'urgence fonctionne 365 jours par an, y compris le dimanche et les jours fériés, sans aucune interruption sur tout le territoire de Chaumont-Gistoux."
  }
];
---

<Layout
  title="Plombier Chaumont-Gistoux (1325) | Dépannage Sanitaire & Urgence 24/7"
  description="Plombier à Chaumont-Gistoux et Dion-Valmont (1325) : surpression, débouchage WC, fuite d'eau, dépannage boiler en 25 min. Devis gratuit au 0465 24 45 71."
>

  <!-- Hero Header -->
  <section class="bg-[#123470] text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="flex items-center gap-2 text-xs font-bold text-white/70">
        <a href="/" class="hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/locations" class="hover:text-white">Zones</a>
        <span>/</span>
        <span class="text-[#fcd400]">Chaumont-Gistoux (1325)</span>
      </div>

      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#fcd400] text-[#101d29] text-xs font-bold uppercase tracking-wider">
        <Icon name="map-pin" class="w-4 h-4 text-[#00327d]" />
        <span>Secteur Chaumont-Gistoux 1325 - Arrivée en 20-30 minutes</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight max-w-4xl">
        Plombier à Chaumont-Gistoux : Urgence Sanitaire, Débouchage & Chauffage 24/7
      </h1>

      <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
        Surpression d'eau à Dion-Valmont ? WC bouché à Chaumont Centre ou panne de chauffage à Bonlez ? Notre artisan plombier intervient en moins de 30 minutes chez vous.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href="tel:0465244571"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95"
        >
          <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
          <span>Urgence Chaumont-Gistoux : 0465 24 45 71</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-display font-bold text-sm shadow-sm transition-all"
        >
          Demander un devis en ligne
        </a>
      </div>

    </div>
  </section>

  <!-- Neighborhood Details & Local Specifics -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Secteurs Communaux
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Particularités Plomberie à Chaumont-Gistoux et Dion-Valmont
        </h2>
        <p class="text-base text-[#434653] leading-relaxed">
          Le réseau de Chaumont-Gistoux se distingue par une pression très élevée sur les points bas (Dion-le-Val, Gistoux) causant de fréquentes avaries sur les canalisations et joints. Notre expertise en réducteurs de pression et régulateurs préserve durablement vos installations sanitaires.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {neighborhoods.map((n) => (
          <div class="bg-[#f7f9ff] p-6 rounded-2xl border border-[#e4eaf1] space-y-3">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {n.name}
            </h3>
            <p class="text-xs text-[#434653] leading-relaxed">
              {n.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Driving Directions from Landmarks -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#705d00] bg-[#fcd400]/20 px-3.5 py-1.5 rounded-full inline-block">
          Itinéraires Directs
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Comment Nous Rejoignons Chaumont-Gistoux en Moins de 30 Minutes
        </h2>
        <p class="text-base text-[#434653]">
          La liaison directe via la Chaussée de Huy (N243) et l'accès N25 permettent à nos dépanneurs d'arriver rapidement à votre adresse.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {directions.map((d) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-[#edf4ff] text-[#0047ab] flex items-center justify-center">
              <Icon name="navigation" class="w-5 h-5 text-[#0047ab]" />
            </div>
            <h3 class="font-display font-bold text-base text-[#101d29]">
              {d.from}
            </h3>
            <p class="text-xs sm:text-sm text-[#434653] leading-relaxed">
              {d.route}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Competitor Comparison Table -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Comparateur Objectif
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Pourquoi Faire Appel à Plombier Wavre Urgent à Chaumont-Gistoux ?
        </h2>
        <p class="text-base text-[#434653]">
          Un service de proximité transparent, sans intermédiaires lointains et avec des garanties complètes.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-xs border border-[#e4eaf1]">
          <thead>
            <tr class="bg-[#123470] text-white text-xs sm:text-sm uppercase tracking-wider">
              <th class="p-4 sm:p-5">Critère Essentiel</th>
              <th class="p-4 sm:p-5 bg-[#0047ab] text-[#fcd400]">Plombier Wavre Urgent</th>
              <th class="p-4 sm:p-5">Plateformes Éloignées</th>
              <th class="p-4 sm:p-5">Artisans Sans Pièces</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4eaf1] text-xs sm:text-sm text-[#434653]">
            {comparison.map((row) => (
              <tr class="hover:bg-[#f7f9ff]">
                <td class="p-4 sm:p-5 font-bold text-[#101d29]">{row.feature}</td>
                <td class="p-4 sm:p-5 bg-[#edf4ff] font-extrabold text-[#00327d]">{row.us}</td>
                <td class="p-4 sm:p-5 text-[#ba1a1a]">{row.competitorA}</td>
                <td class="p-4 sm:p-5">{row.competitorB}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- FAQs Chaumont-Gistoux -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff] border-t border-[#e4eaf1]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Vos Questions
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Questions Fréquentes à Chaumont-Gistoux
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-2">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {f.q}
            </h3>
            <p class="text-sm text-[#434653] leading-relaxed">
              {f.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Emergency Banner -->
  <section class="bg-[#00327d] text-white py-12 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="space-y-2">
        <h2 class="font-display font-black text-2xl sm:text-3xl text-white">
          Urgence plomberie à Chaumont-Gistoux ou Dion-Valmont ?
        </h2>
        <p class="text-white/80 text-sm max-w-xl">
          Nos plombiers d'astreinte sont opérationnels maintenant. Intervention rapide et devis clair.
        </p>
      </div>
      <a
        href="tel:0465244571"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95 shrink-0"
      >
        <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
        <span>0465 24 45 71</span>
      </a>
    </div>
  </section>

</Layout>
