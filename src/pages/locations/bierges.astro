---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const neighborhoods = [
  { name: "Bierges Centre & Route Provinciale", desc: "Axe historique et commerçant. Débouchage rapide d'éviers, dépannage WC et réparation de fuites." },
  { name: "Fond Marie & Clos des Chênes", desc: "Quartiers résidentiels calmes. Pose d'adoucisseurs d'eau anti-calcaire et détartrage de boilers électriques." },
  { name: "Zone Commerciale & Échangeur E411", desc: "Commerces, bureaux et PME. Maintenance sanitaire, débouchage de colonnes et interventions express." },
  { name: "Secteur Vert & Limite Rixensart", desc: "Grandes propriétés arborées. Entretien des réseaux d'égouttage, fosses septiques et canalisations extérieures." }
];

const directions = [
  {
    from: "Depuis la sortie 5 de l'E411 (Bierges)",
    route: "Prendre directement la N4 vers Bierges Centre puis bifurquer Route Provinciale. Temps de trajet : 3 à 5 minutes (1.8 km)."
  },
  {
    from: "Depuis la Place Cardinal Mercier (Wavre)",
    route: "Suivre la Chaussée de Bruxelles vers le nord, puis monter la Route Provinciale. Temps de trajet : 6 minutes (3.2 km)."
  },
  {
    from: "Depuis le zoning commercial des Deux Arches",
    route: "Rejoindre la Chaussée de Colnet puis la Rue Provinciale. Temps de trajet : 4 minutes."
  }
];

const comparison = [
  {
    feature: "Délai d'intervention à Bierges (1301)",
    us: "15 à 25 minutes garanties",
    competitorA: "48h de délai minimum (Heat-me)",
    competitorB: "Aucune équipe d'astreinte de nuit (HD Therm)"
  },
  {
    feature: "Équipement Haute Pression Embarqué",
    us: "Hydrocureuse 150 bars et caméra HD",
    competitorA: "Matériel manuel ou furet basique",
    competitorB: "Sous-traitance des débouchages lourds"
  },
  {
    feature: "Spécialisation Calcaire Bierges",
    us: "Partenaire BWT & Durlem avec test d'eau",
    competitorA: "Aucune analyse sur place",
    competitorB: "Pose sans réglage volumétrique précis"
  },
  {
    feature: "Permanence Urgence Week-end & Nuit",
    us: "24h/24 et 7j/7 avec technicien local",
    competitorA: "Centrale d'appels externe sans astreinte",
    competitorB: "Fermeture le samedi et dimanche"
  },
  {
    feature: "Facture Agréée Dégâts des Eaux",
    us: "100% conforme pour toutes assurances belges",
    competitorA: "Dossier incomplet souvent rejeté",
    competitorB: "Facturation manuscrite sans détails"
  }
];

const faqs = [
  {
    q: "Dans quel délai pouvez-vous être à Bierges en cas de fuite ?",
    a: "Grâce à notre proximité immédiate avec la sortie 5 de l'autoroute E411 et la N4, nous arrivons généralement en 15 à 20 minutes à Bierges (1301)."
  },
  {
    q: "Pourquoi les boilers s'entartrent-ils rapidement à Bierges ?",
    a: "L'eau de distribution à Bierges dépasse souvent les 33 degrés français de dureté calcique. Sans adoucisseur, la résistance du boiler se recouvre d'une épaisse gangue de tartre en moins de deux ans."
  },
  {
    q: "Prenez-vous en charge les entretiens de chaudières à Bierges ?",
    a: "Oui. Nos chauffagistes sont habilités Cerga Gaz pour la Région Wallonne et délivrent l'attestation de contrôle périodique légale pour votre chaudière au gaz ou mazout."
  }
];
---

<Layout
  title="Plombier Bierges (1301) | Dépannage Plomberie & Chauffage 24/7"
  description="Plombier à Bierges (1301) : dépannage rapide en 20 min pour fuite d'eau, débouchage canalisation, boiler en panne. Devis gratuit. Tél : 0465 24 45 71."
>

  <!-- Hero Header -->
  <section class="bg-[#123470] text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="flex items-center gap-2 text-xs font-bold text-white/70">
        <a href="/" class="hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/locations" class="hover:text-white">Zones</a>
        <span>/</span>
        <span class="text-[#fcd400]">Bierges (1301)</span>
      </div>

      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#fcd400] text-[#101d29] text-xs font-bold uppercase tracking-wider">
        <Icon name="map-pin" class="w-4 h-4 text-[#00327d]" />
        <span>Secteur Bierges 1301 - Arrivée en 20 minutes</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight max-w-4xl">
        Plombier à Bierges (1301) : Dépannage d'Urgence et Chauffage 24/7
      </h1>

      <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
        Une conduite percée route Provinciale ? Un boiler en panne avenue Fond Marie ? Notre permanence d'artisans plombiers intervient jour et nuit en moins de 25 minutes sur Bierges et ses environs.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href="tel:0465244571"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95"
        >
          <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
          <span>Appel Urgence Bierges : 0465 24 45 71</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-display font-bold text-sm shadow-sm transition-all"
        >
          Demander un devis pour Bierges
        </a>
      </div>

    </div>
  </section>

  <!-- Neighborhood Details & Local Specifics -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Spécificités du Secteur
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          La Plomberie à Bierges (1301) : Habitats et Réseaux
        </h2>
        <p class="text-base text-[#434653] leading-relaxed">
          Bierges combine des zones d'activités tertiaires près de l'échangeur E411 et de nombreux quartiers pavillonnaires résidentiels. Les habitations y possèdent souvent de grands sous-sols et des raccordements extérieurs nécessitant des nettoyages haute pression réguliers des sterputs et descentes de garage.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {neighborhoods.map((n) => (
          <div class="bg-[#f7f9ff] p-6 rounded-2xl border border-[#e4eaf1] space-y-3">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {n.name}
            </h3>
            <p class="text-xs text-[#434653] leading-relaxed">
              {n.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Driving Directions from Landmarks -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#705d00] bg-[#fcd400]/20 px-3.5 py-1.5 rounded-full inline-block">
          Accès Rapide
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Itinéraires pour Rejoindre Bierges en Moins de 20 Minutes
        </h2>
        <p class="text-base text-[#434653]">
          Nos techniciens contournent les encombrements grâce à des liaisons directes par la N4 et les sorties autoroutières immédiates.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {directions.map((d) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-[#edf4ff] text-[#0047ab] flex items-center justify-center">
              <Icon name="navigation" class="w-5 h-5 text-[#0047ab]" />
            </div>
            <h3 class="font-display font-bold text-base text-[#101d29]">
              {d.from}
            </h3>
            <p class="text-xs sm:text-sm text-[#434653] leading-relaxed">
              {d.route}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Competitor Comparison Table -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Comparatif Concret
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Plombier Wavre Urgent vs Autres Prestataires à Bierges
        </h2>
        <p class="text-base text-[#434653]">
          Découvrez pourquoi les propriétaires de Bierges nous font confiance pour leurs travaux sanitaires et de chauffage.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-xs border border-[#e4eaf1]">
          <thead>
            <tr class="bg-[#123470] text-white text-xs sm:text-sm uppercase tracking-wider">
              <th class="p-4 sm:p-5">Prestation & Service</th>
              <th class="p-4 sm:p-5 bg-[#0047ab] text-[#fcd400]">Plombier Wavre Urgent</th>
              <th class="p-4 sm:p-5">Plateformes Nationales</th>
              <th class="p-4 sm:p-5">Concurrents Locaux</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4eaf1] text-xs sm:text-sm text-[#434653]">
            {comparison.map((row) => (
              <tr class="hover:bg-[#f7f9ff]">
                <td class="p-4 sm:p-5 font-bold text-[#101d29]">{row.feature}</td>
                <td class="p-4 sm:p-5 bg-[#edf4ff] font-extrabold text-[#00327d]">{row.us}</td>
                <td class="p-4 sm:p-5 text-[#ba1a1a]">{row.competitorA}</td>
                <td class="p-4 sm:p-5">{row.competitorB}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- FAQs Bierges -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff] border-t border-[#e4eaf1]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Vos Questions
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Questions Fréquentes sur Nos Dépannages à Bierges
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-2">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {f.q}
            </h3>
            <p class="text-sm text-[#434653] leading-relaxed">
              {f.a}
            </p>
          </div>
        ))}
      </div>

      <!-- Action Callout -->
      <div class="bg-[#0047ab] rounded-2xl p-8 text-center text-white space-y-4 shadow-xl">
        <h3 class="font-display font-extrabold text-2xl text-white">
          Besoin d'un artisan plombier à Bierges (1301) ?
        </h3>
        <p class="text-sm text-white/80 max-w-xl mx-auto">
          Intervention d'urgence ou devis gratuit sans engagement. Nos artisans sont prêts à partir.
        </p>
        <div class="pt-2">
          <a
            href="tel:0465244571"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] text-[#101d29] font-display font-extrabold text-base hover:bg-[#e9c400] shadow-md transition-all active:scale-95"
          >
            <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
            <span>0465 24 45 71 (Arrivée en 20 min)</span>
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
