---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';

const neighborhoods = [
  { name: "Louvain-la-Neuve (Hocaille, Lauzelle, Biéreau)", desc: "Cité piétonne et universitaire : gestion des kots étudiants, sanitaires collectifs, débouchage urgent de colonnes et interventions piétonnes rapides." },
  { name: "Ottignies Centre & Gare des Chemins de Fer", desc: "Quartier urbain dense : fuites d'eau après compteur, remplacement de chauffe-eau en urgence et débouchage de canalisations anciennes." },
  { name: "Limelette & Fonds de Rofessart", desc: "Zone résidentielle et vallonnée : régulation de la pression d'eau, protection contre les coups de bélier et entretien de chaudières gaz à condensation." },
  { name: "Mousty & Céroux-Mousty", desc: "Maisons individuelles et corps de ferme rénovés : traitement du calcaire SWDE, installation d'adoucisseurs et détection non-destructive de fuites." }
];

const directions = [
  {
    from: "Depuis la Place de l'Université (Louvain-la-Neuve)",
    route: "Prendre le Boulevard de Lauzelle puis la N238 directement vers Wavre. Temps d'intervention : 8 à 12 minutes (environ 6 km)."
  },
  {
    from: "Depuis la Gare SNCB d'Ottignies",
    route: "Emprunter l'Avenue des Combattants puis la N238 ou Boulevard Léopold III vers Wavre Centre. Temps d'intervention : 10 minutes (environ 7 km)."
  },
  {
    from: "Depuis la N25 (Échangeur de Genappe / Ottignies)",
    route: "Rejoindre la N238 vers le nord en direction de Wavre / E411. Accès direct en moins de 10 minutes sans traverser les zones piétonnes."
  }
];

const comparison = [
  {
    feature: "Délai d'arrivée à Ottignies-LLN (1340/1348)",
    us: "20 à 30 minutes garanties",
    competitorA: "48h à 72h (Heat-me)",
    competitorB: "Délais imprévisibles (artisans éloignés)"
  },
  {
    feature: "Intervention en Zone Piétonne LLN",
    us: "Matériel portatif adapté aux ruelles piétonnes",
    competitorA: "Refuse ou facture un surcoût piéton",
    competitorB: "Difficultés d'accès et stationnement"
  },
  {
    feature: "Urgence Étudiants et Kots",
    us: "Tarifs transparents avec devis préalable clair",
    competitorA: "Tarifs prohibitifs hors forfait",
    competitorB: "Intervention souvent reportée au lundi"
  },
  {
    feature: "Permanence Nuit, Week-end et Fériés",
    us: "24h/24 et 7j/7 réelle sur le Brabant Wallon",
    competitorA: "Centre d'appels fermé le soir",
    competitorB: "Pas de permanence le dimanche"
  },
  {
    feature: "Certification Cerga & Dégâts des Eaux",
    us: "Agréé Cerga Gaz et rapport photo pour assurances",
    competitorA: "Non labellisé pour le gaz en Wallonie",
    competitorB: "Pas de rapport d'expertise détaillé"
  }
];

const faqs = [
  {
    q: "Intervenez-vous dans les kots et logements étudiants à Louvain-la-Neuve ?",
    a: "Oui. Nous intervenons quotidiennement dans le centre urbain piéton de Louvain-la-Neuve (Hocaille, Biéreau, Lauzelle, Bruyères). Nous sommes équipés de chariots techniques pour transporter notre matériel de débouchage et de soudure dans les zones réservées aux piétons."
  },
  {
    q: "Quelle est la qualité et la dureté de l'eau à Ottignies-Louvain-la-Neuve ?",
    a: "L'eau distribuée sur l'entité d'Ottignies-LLN par l'inBW et la SWDE présente un taux de calcaire élevé, généralement compris entre 30 et 35 degrés français. L'installation d'un adoucisseur d'eau y est vivement recommandée pour protéger vos chaudières et robinetteries."
  },
  {
    q: "Quel est le délai moyen pour un débouchage urgent à Ottignies ?",
    a: "Grâce à notre position stratégique à Wavre et l'accès direct par la N238, nous arrivons chez vous en 20 à 30 minutes après votre appel pour tout débouchage urgent de WC ou évier."
  }
];
---

<Layout
  title="Plombier Ottignies-Louvain-la-Neuve (1340 - 1348) | Dépannage 24/7"
  description="Plombier à Ottignies et Louvain-la-Neuve (1340, 1348) : dépannage fuite, débouchage WC et kot, chaudière en panne en 25 min. Devis gratuit au 010 39 50 10."
>

  <!-- Hero Header -->
  <section class="bg-[#123470] text-white py-16 lg:py-20 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="flex items-center gap-2 text-xs font-bold text-white/70">
        <a href="/" class="hover:text-white">Accueil</a>
        <span>/</span>
        <a href="/locations" class="hover:text-white">Zones</a>
        <span>/</span>
        <span class="text-[#fcd400]">Ottignies-Louvain-la-Neuve (1340 / 1348)</span>
      </div>

      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#fcd400] text-[#101d29] text-xs font-bold uppercase tracking-wider">
        <Icon name="map-pin" class="w-4 h-4 text-[#00327d]" />
        <span>Secteur Ottignies-LLN 1340 / 1348 - Arrivée en 20-30 minutes</span>
      </div>

      <h1 class="font-display font-extrabold text-3xl sm:text-5xl text-white tracking-tight max-w-4xl">
        Plombier à Ottignies-Louvain-la-Neuve : Urgence Sanitaire et Chauffage 24/7
      </h1>

      <p class="text-base sm:text-lg text-white/80 max-w-2xl leading-relaxed">
        Une fuite d'eau à Limelette ? Des WC bouchés dans un kot à Louvain-la-Neuve ou un problème de chaudière à Ottignies Centre ? Notre équipe locale intervient 7j/7 et 24h/24 en moins de 30 minutes.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
        <a
          href="tel:010395010"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95"
        >
          <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
          <span>Appel Direct Ottignies-LLN : 010 39 50 10</span>
        </a>
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/20 font-display font-bold text-sm shadow-sm transition-all"
        >
          Demander un devis gratuit
        </a>
      </div>

    </div>
  </section>

  <!-- Neighborhood Details & Local Specifics -->
  <section class="py-16 sm:py-24 bg-white border-b border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Couverture Sectorielle
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Services Plomberie par Quartier à Ottignies et Louvain-la-Neuve
        </h2>
        <p class="text-base text-[#434653] leading-relaxed">
          Entre le plateau piétonnier de Louvain-la-Neuve aux accès spécifiques et les quartiers résidentiels d'Ottignies ou Limelette, nos interventions s'adaptent précisément à la configuration de chaque bâtiment et aux normes d'urbanisme locales.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {neighborhoods.map((n) => (
          <div class="bg-[#f7f9ff] p-6 rounded-2xl border border-[#e4eaf1] space-y-3">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {n.name}
            </h3>
            <p class="text-xs text-[#434653] leading-relaxed">
              {n.desc}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Driving Directions from Landmarks -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#705d00] bg-[#fcd400]/20 px-3.5 py-1.5 rounded-full inline-block">
          Accès Rapide
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Itinéraires d'Intervention depuis les Points Stratégiques
        </h2>
        <p class="text-base text-[#434653]">
          Positionnés à Wavre, nos véhicules de dépannage rejoignent Ottignies et Louvain-la-Neuve en quelques minutes via la N238 et la N25.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {directions.map((d) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-3">
            <div class="w-10 h-10 rounded-xl bg-[#edf4ff] text-[#0047ab] flex items-center justify-center">
              <Icon name="navigation" class="w-5 h-5 text-[#0047ab]" />
            </div>
            <h3 class="font-display font-bold text-base text-[#101d29]">
              {d.from}
            </h3>
            <p class="text-xs sm:text-sm text-[#434653] leading-relaxed">
              {d.route}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Competitor Comparison Table -->
  <section class="py-16 sm:py-24 bg-white border-t border-[#e4eaf1]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Transparence Totale
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Comparatif avec les Dépanneurs du Secteur Ottignies-LLN
        </h2>
        <p class="text-base text-[#434653]">
          Découvrez pourquoi les propriétaires, gestionnaires de kots et locataires font confiance à Plombier Wavre Urgent.
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse bg-white rounded-2xl overflow-hidden shadow-xs border border-[#e4eaf1]">
          <thead>
            <tr class="bg-[#123470] text-white text-xs sm:text-sm uppercase tracking-wider">
              <th class="p-4 sm:p-5">Critère de Service</th>
              <th class="p-4 sm:p-5 bg-[#0047ab] text-[#fcd400]">Plombier Wavre Urgent</th>
              <th class="p-4 sm:p-5">Plateformes Nationales</th>
              <th class="p-4 sm:p-5">Artisans Sans Astreinte</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#e4eaf1] text-xs sm:text-sm text-[#434653]">
            {comparison.map((row) => (
              <tr class="hover:bg-[#f7f9ff]">
                <td class="p-4 sm:p-5 font-bold text-[#101d29]">{row.feature}</td>
                <td class="p-4 sm:p-5 bg-[#edf4ff] font-extrabold text-[#00327d]">{row.us}</td>
                <td class="p-4 sm:p-5 text-[#ba1a1a]">{row.competitorA}</td>
                <td class="p-4 sm:p-5">{row.competitorB}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

  <!-- FAQs Ottignies-LLN -->
  <section class="py-16 sm:py-24 bg-[#f7f9ff] border-t border-[#e4eaf1]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center space-y-4">
        <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3.5 py-1.5 rounded-full inline-block">
          Vos Questions
        </span>
        <h2 class="font-display font-extrabold text-2xl sm:text-4xl text-[#101d29] tracking-tight">
          Foire Aux Questions : Dépannage Plomberie à Ottignies & LLN
        </h2>
      </div>

      <div class="space-y-4">
        {faqs.map((f) => (
          <div class="bg-white p-6 rounded-2xl border border-[#e4eaf1] shadow-xs space-y-2">
            <h3 class="font-display font-bold text-base text-[#00327d]">
              {f.q}
            </h3>
            <p class="text-sm text-[#434653] leading-relaxed">
              {f.a}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Emergency Banner -->
  <section class="bg-[#00327d] text-white py-12 border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div class="space-y-2">
        <h2 class="font-display font-black text-2xl sm:text-3xl text-white">
          Besoin d'un dépannage immédiat à Ottignies ou Louvain-la-Neuve ?
        </h2>
        <p class="text-white/80 text-sm max-w-xl">
          Notre technicien de garde est prêt à partir. Appel direct sans intermédiaire ni frais cachés.
        </p>
      </div>
      <a
        href="tel:010395010"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-extrabold text-base shadow-lg transition-transform active:scale-95 shrink-0"
      >
        <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
        <span>010 39 50 10</span>
      </a>
    </div>
  </section>

</Layout>
