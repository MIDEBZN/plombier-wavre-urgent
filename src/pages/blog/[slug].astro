---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { articles, getRelatedArticles, type BlogArticle } from '../../data/articles';
import { markdownToHtml, extractHeadings } from '../../utils/markdown';

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: BlogArticle;
}

const { article } = Astro.props;
const related = getRelatedArticles(article.slug, 3);
const htmlContent = markdownToHtml(article.contentMarkdown);
const headings = extractHeadings(article.contentMarkdown);

// Schema.org Article & FAQPage JSON-LD
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.h1,
  "description": article.metaDescription,
  "inLanguage": "fr-BE",
  "datePublished": article.datePublished,
  "dateModified": "2026-04-14",
  "author": {
    "@type": "Organization",
    "name": "Plombier Wavre Urgent",
    "url": "https://www.plombierwavreurgent.be"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Plombier Wavre Urgent",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.plombierwavreurgent.be/logo.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.plombierwavreurgent.be/blog/${article.slug}`
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": article.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.a
    }
  }))
};
---

<Layout
  title={article.title}
  description={article.metaDescription}
>

  <!-- Inject Schema.org Article & FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Breadcrumb Navigation -->
  <div class="bg-white border-b border-[#e4eaf1] py-3">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs text-[#434653]" aria-label="Fil d'Ariane">
        <a href="/" class="hover:text-[#0047ab] transition-colors">Accueil</a>
        <Icon name="arrow-right" class="w-3 h-3 text-[#705d00]" />
        <a href="/blog" class="hover:text-[#0047ab] transition-colors">Guides & Tarifs</a>
        <Icon name="arrow-right" class="w-3 h-3 text-[#705d00]" />
        <span class="text-[#101d29] font-medium truncate max-w-xs sm:max-w-md">{article.topic}</span>
      </nav>
    </div>
  </div>

  <article class="py-10 sm:py-16 bg-[#f7f9ff]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Article Header -->
      <header class="bg-white rounded-3xl p-6 sm:p-10 border border-[#e4eaf1] shadow-xs space-y-6">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-xs font-extrabold uppercase tracking-wider text-[#0047ab] bg-[#edf4ff] px-3 py-1 rounded-full">
            {article.category}
          </span>
          <span class="text-xs text-[#434653] flex items-center gap-1">
            <Icon name="clock" class="w-3.5 h-3.5 text-[#705d00]" />
            {article.readingTime} de lecture
          </span>
          <span class="text-xs text-[#059669] font-semibold bg-[#059669]/10 px-2.5 py-0.5 rounded-full">
            Mis à jour 2026
          </span>
        </div>

        <h1 class="font-display font-extrabold text-2xl sm:text-4xl lg:text-5xl text-[#00327d] tracking-tight leading-tight">
          {article.h1}
        </h1>

        <!-- Direct Quotable AI Answer Paragraph (AEO / Voice Search) -->
        <div class="bg-[#edf4ff] border-l-4 border-[#0047ab] p-5 sm:p-6 rounded-r-2xl space-y-2">
          <div class="flex items-center gap-2 text-xs font-extrabold uppercase tracking-wider text-[#00327d]">
            <Icon name="award" class="w-4 h-4 text-[#fcd400]" />
            <span>Réponse Directe d'Artisan Plombier à Wavre (AEO)</span>
          </div>
          <p class="text-sm sm:text-base font-semibold text-[#101d29] leading-relaxed">
            {article.aiSnippet}
          </p>
        </div>

        <!-- Search Intent Introduction -->
        <p class="text-base sm:text-lg text-[#434653] leading-relaxed font-normal pt-2">
          {article.intro}
        </p>

        <!-- Fast Emergency Callout -->
        <div class="pt-4 border-t border-[#e4eaf1] flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-xs text-[#434653]">
            <strong class="text-[#101d29] block">Besoin d'une intervention immédiate à Wavre ?</strong>
            Technicien de garde disponible en 30 minutes.
          </div>
          <a
            href="tel:0465244571"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0047ab] text-white font-display font-bold text-xs hover:bg-[#00327d] shadow-sm transition-all"
          >
            <Icon name="phone" class="w-3.5 h-3.5 text-[#fcd400]" />
            <span>0465 24 45 71 (Ligne directe)</span>
          </a>
        </div>
      </header>

      <!-- Table of Contents -->
      {headings.length > 0 && (
        <nav class="mt-8 bg-white rounded-2xl p-6 border border-[#e4eaf1] shadow-xs">
          <h2 class="font-display font-bold text-sm uppercase tracking-wider text-[#00327d] mb-3 flex items-center gap-2">
            <Icon name="check" class="w-4 h-4 text-[#0047ab]" />
            <span>Sommaire de l'article</span>
          </h2>
          <ul class="space-y-2 text-xs sm:text-sm">
            {headings.map((h) => (
              <li class={h.level === 3 ? "ml-4" : ""}>
                <a href={`#${h.id}`} class="text-[#434653] hover:text-[#0047ab] hover:underline transition-colors flex items-center gap-1.5">
                  <span class="text-[#705d00] font-bold">•</span>
                  <span>{h.text}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- Main Article Body -->
      <div class="mt-8 bg-white rounded-3xl p-6 sm:p-10 border border-[#e4eaf1] shadow-xs prose max-w-none text-[#434653]">
        <div set:html={htmlContent} />
      </div>

      <!-- FAQ Section (Featured Snippets Winner) -->
      {article.faqs.length > 0 && (
        <section class="mt-10 bg-white rounded-3xl p-6 sm:p-10 border border-[#e4eaf1] shadow-xs space-y-6">
          <div class="space-y-2">
            <span class="text-xs font-extrabold uppercase tracking-widest text-[#0047ab] bg-[#edf4ff] px-3 py-1 rounded-full inline-block">
              Foire Aux Questions
            </span>
            <h2 class="font-display font-extrabold text-2xl sm:text-3xl text-[#101d29]">
              Questions Fréquentes sur ce Sujet
            </h2>
          </div>

          <div class="space-y-4">
            {article.faqs.map((faq) => (
              <div class="bg-[#f7f9ff] rounded-2xl p-5 sm:p-6 border border-[#e4eaf1] space-y-2">
                <h3 class="font-display font-bold text-base text-[#00327d]">
                  {faq.q}
                </h3>
                <p class="text-sm text-[#434653] leading-relaxed">
                  {faq.a}
                </p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Internal Links / Recommended Pages -->
      {article.internalLinks && article.internalLinks.length > 0 && (
        <div class="mt-8 bg-[#edf4ff] rounded-2xl p-6 border border-[#0047ab]/20 space-y-3">
          <span class="text-xs font-bold uppercase tracking-wider text-[#00327d] block">
            Prestations et pages associées :
          </span>
          <div class="flex flex-wrap gap-2.5">
            {article.internalLinks.map((link) => (
              <a
                href={link.url}
                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-white text-xs font-semibold text-[#00327d] border border-[#0047ab]/20 hover:border-[#0047ab] shadow-2xs transition-all"
              >
                <span>{link.anchor}</span>
                <Icon name="arrow-right" class="w-3 h-3 text-[#705d00]" />
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Related Articles Carousel / Grid -->
      {related.length > 0 && (
        <section class="mt-12 space-y-6">
          <h2 class="font-display font-bold text-xl sm:text-2xl text-[#101d29]">
            Guides Complémentaires Recommandés
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {related.map((rel) => (
              <div class="bg-white rounded-2xl p-5 border border-[#e4eaf1] shadow-xs flex flex-col justify-between hover:border-[#0047ab]/30 transition-all">
                <div class="space-y-2">
                  <span class="text-[10px] font-bold uppercase text-[#0047ab] bg-[#edf4ff] px-2 py-0.5 rounded">
                    {rel.category}
                  </span>
                  <h3 class="font-display font-bold text-sm text-[#101d29] leading-snug">
                    <a href={`/blog/${rel.slug}`} class="hover:text-[#0047ab] transition-colors">
                      {rel.topic}
                    </a>
                  </h3>
                </div>
                <div class="pt-4 mt-4 border-t border-[#e4eaf1]">
                  <a href={`/blog/${rel.slug}`} class="text-xs font-bold text-[#0047ab] flex items-center gap-1">
                    <span>Consulter le guide</span>
                    <Icon name="arrow-right" class="w-3 h-3" />
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Emergency Help Box -->
      <div class="mt-12 bg-[#0047ab] rounded-3xl p-8 sm:p-10 text-white text-center space-y-4 shadow-xl">
        <h3 class="font-display font-extrabold text-2xl text-white">
          Besoin d'un dépannage plomberie immédiat à Wavre ?
        </h3>
        <p class="text-sm text-white/80 max-w-xl mx-auto">
          Nos artisans diplômés sont en camionnettes d'astreinte équipées et arrivent chez vous en moins de 30 minutes.
        </p>
        <div class="pt-2">
          <a
            href="tel:0465244571"
            class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-[#fcd400] text-[#101d29] font-display font-extrabold text-base hover:bg-[#e9c400] shadow-md transition-all active:scale-95"
          >
            <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
            <span>0465 24 45 71 : Intervention immédiate</span>
          </a>
        </div>
      </div>

    </div>
  </article>

</Layout>
