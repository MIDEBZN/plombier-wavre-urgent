---
import Icon from './Icon.astro';
---

<!-- Floating Sticky Click-to-Call Desktop Pill (Bottom Left) -->
<aside class="fixed bottom-6 left-6 z-40 hidden md:flex items-center gap-3.5 bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] pl-4 pr-5 py-3 rounded-full shadow-2xl border-2 border-white transition-all transform hover:scale-105 active:scale-95 group">
  <div class="relative flex items-center justify-center w-8 h-8 rounded-full bg-[#00327d] text-white">
    <Icon name="phone" class="w-4 h-4 text-[#fcd400]" />
    <span class="absolute -top-1 -right-1 w-3 h-3 bg-[#059669] border-2 border-white rounded-full animate-ping"></span>
    <span class="absolute -top-1 -right-1 w-3 h-3 bg-[#059669] border-2 border-white rounded-full"></span>
  </div>
  <a href="tel:0489865765" class="flex flex-col text-left">
    <span class="text-[10px] uppercase font-black tracking-wider text-[#00327d] leading-none">
      Astreinte 24/7 (30 min)
    </span>
    <span class="font-display font-extrabold text-base text-[#101d29] leading-tight tabular-nums">
      0489 86 57 65
    </span>
  </a>
</aside>

<!-- WhatsApp Live Chat Floating Widget (Bottom Right) -->
<div class="fixed bottom-24 md:bottom-6 right-5 z-40 flex flex-col items-end">
  
  <!-- Mini Chat Popup Card (Initially togglable or visible preview) -->
  <div
    id="whatsapp-chat-box"
    class="hidden mb-3 w-80 bg-white rounded-2xl shadow-2xl border border-[#e4eaf1] overflow-hidden transform transition-all animate-fade-in"
  >
    <!-- Chat Header -->
    <div class="bg-[#123470] p-4 text-white flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-full bg-[#0047ab] flex items-center justify-center text-white font-bold">
          <Icon name="wrench" class="w-5 h-5 text-[#fcd400]" />
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-[#059669] border-2 border-[#123470] rounded-full"></span>
        </div>
        <div>
          <span class="font-display font-bold text-sm block leading-none">Plombier Wavre Urgent</span>
          <span class="text-[11px] text-[#fcd400] flex items-center gap-1 mt-1">
            <span class="w-1.5 h-1.5 rounded-full bg-[#059669] inline-block"></span>
            En ligne - Technicien d'astreinte
          </span>
        </div>
      </div>
      <button
        id="close-chat-box"
        type="button"
        class="text-white/70 hover:text-white p-1 rounded-lg focus:outline-none"
        aria-label="Fermer la discussion"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Chat Body -->
    <div class="p-4 bg-[#f7f9ff] space-y-3">
      <div class="bg-white p-3 rounded-2xl rounded-tl-none border border-[#e4eaf1] text-xs text-[#434653] leading-relaxed shadow-xs">
        <p class="font-bold text-[#101d29] mb-1">Bonjour !</p>
        <p>Une question ou un dépannage en urgence à Wavre ou dans les environs ? Envoyez-nous un message ou la photo de votre fuite sur WhatsApp, nous répondons immédiatement.</p>
        <span class="text-[10px] text-[#434653]/60 block mt-1 text-right">Disponible 24h/24</span>
      </div>
    </div>

    <!-- Chat Action -->
    <div class="p-3 bg-white border-t border-[#e4eaf1]">
      <a
        href="https://wa.me/32489865765?text=Bonjour,%20j%27ai%20besoin%20d%27un%20plombier%20urgent%20%C3%A0%20Wavre."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full inline-flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-[#25D366] hover:bg-[#20ba5a] text-white font-display font-bold text-xs shadow-md transition-colors"
      >
        <Icon name="whatsapp" class="w-4 h-4 text-white" />
        <span>Ouvrir WhatsApp</span>
      </a>
    </div>
  </div>

  <!-- WhatsApp Floating Trigger Button -->
  <button
    id="toggle-whatsapp-btn"
    type="button"
    class="flex items-center gap-2.5 bg-[#25D366] hover:bg-[#20ba5a] text-white pl-4 pr-4 py-3 rounded-full shadow-2xl transition-transform hover:scale-105 active:scale-95 group focus:outline-none"
    aria-label="Discussion WhatsApp"
  >
    <div class="relative">
      <Icon name="whatsapp" class="w-6 h-6 text-white" />
      <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-white rounded-full"></span>
      <span class="absolute -top-1 -right-1 w-2.5 h-2.5 bg-[#ba1a1a] rounded-full animate-ping"></span>
    </div>
    <span class="font-display font-bold text-xs hidden sm:inline-block pr-1">
      WhatsApp Direct
    </span>
  </button>

</div>

<script>
  const toggleBtn = document.getElementById('toggle-whatsapp-btn');
  const closeBtn = document.getElementById('close-chat-box');
  const chatBox = document.getElementById('whatsapp-chat-box');

  if (toggleBtn && chatBox) {
    toggleBtn.addEventListener('click', () => {
      chatBox.classList.toggle('hidden');
    });
  }

  if (closeBtn && chatBox) {
    closeBtn.addEventListener('click', () => {
      chatBox.classList.add('hidden');
    });
  }
</script>
