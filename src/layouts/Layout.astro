---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import TrustGuarantees from '../components/TrustGuarantees.astro';
import ContactFormSection from '../components/ContactFormSection.astro';
import WhatsAppChatWidget from '../components/WhatsAppChatWidget.astro';
import GoogleMapEmbed from '../components/GoogleMapEmbed.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schemaType?: string;
}

const {
  title,
  description,
  canonical,
  schemaType = "Plumber"
} = Astro.props;

const siteUrl = "https://www.plombierwavreurgent.be";
const rawPath = Astro.url.pathname;
const cleanPath = rawPath === "/" ? "" : rawPath.replace(/\/+$/, "");
const canonicalUrl = canonical || (cleanPath ? `${siteUrl}${cleanPath}` : `${siteUrl}/`);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Accueil" },
  { href: "/services", label: "Services" },
  { href: "/locations", label: "Zones d'intervention" },
  { href: "/blog", label: "Guides & Tarifs" },
  { href: "/about", label: "A propos" },
  { href: "/contact", label: "Contact & Devis" },
];

const pathSegments = cleanPath.split("/").filter(Boolean);

const breadcrumbElements: any[] = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Accueil",
    "item": `${siteUrl}/`
  }
];

if (pathSegments.length >= 1) {
  const sectionSlug = pathSegments[0];
  const sectionNames: Record<string, string> = {
    services: "Services",
    locations: "Zones d'intervention",
    blog: "Guides & Tarifs",
    about: "A propos",
    contact: "Contact & Devis"
  };
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 2,
    "name": sectionNames[sectionSlug] || sectionSlug,
    "item": `${siteUrl}/${sectionSlug}`
  });
}

if (pathSegments.length >= 2) {
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 3,
    "name": title.split("|")[0].trim(),
    "item": canonicalUrl
  });
}

const structuredDataGraph: any[] = [
  {
    "@type": ["Plumber", "EmergencyService", "LocalBusiness"],
    "@id": "https://www.plombierwavreurgent.be/#plumber",
    "name": "Plombier Wavre Urgent",
    "legalName": "Ecly Plombier Wavre Urgent",
    "image": "https://www.plombierwavreurgent.be/logo.png",
    "logo": "https://www.plombierwavreurgent.be/logo.png",
    "url": "https://www.plombierwavreurgent.be",
    "telephone": "+32489865765",
    "email": "contact@plombierwavreurgent.be",
    "description": "Artisan plombier à Wavre (1300) agréé et disponible 24h/24 et 7j/7 pour dépannage d'urgence en 30 minutes, débouchage canalisation, détection de fuite non destructive, entretien chaudière et adoucisseur d'eau.",
    "priceRange": "€€",
    "currenciesAccepted": "EUR",
    "paymentAccepted": "Cash, Carte bancaire, Bancontact, Payconiq, Virement bancaire",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rue Charles Jaumotte 76",
      "addressLocality": "Wavre",
      "postalCode": "1300",
      "addressRegion": "Brabant Wallon",
      "addressCountry": "BE"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 50.697397,
      "longitude": 4.577067
    },
    "hasMap": "https://maps.app.goo.gl/oCBeEPNkZFPVsKrB9",
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      }
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "bestRating": "5",
      "worstRating": "1",
      "ratingCount": "148"
    },
    "areaServed": [
      { "@type": "City", "name": "Wavre", "postalCode": "1300" },
      { "@type": "City", "name": "Limal", "postalCode": "1300" },
      { "@type": "City", "name": "Bierges", "postalCode": "1301" },
      { "@type": "City", "name": "Ottignies-Louvain-la-Neuve", "postalCode": "1340" },
      { "@type": "City", "name": "Louvain-la-Neuve", "postalCode": "1348" },
      { "@type": "City", "name": "Rixensart", "postalCode": "1330" },
      { "@type": "City", "name": "Genval", "postalCode": "1332" },
      { "@type": "City", "name": "Grez-Doiceau", "postalCode": "1390" },
      { "@type": "City", "name": "Chaumont-Gistoux", "postalCode": "1325" },
      { "@type": "City", "name": "La Hulpe", "postalCode": "1310" },
      { "@type": "City", "name": "Waterloo", "postalCode": "1410" }
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Catalogue des Services de Plomberie et Depannage Wavre",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Depannage plomberie d'urgence 24h/24",
            "description": "Intervention d'urgence en moins de 30 minutes a Wavre pour fuite d'eau, rupture de canalisation, panne chauffe-eau ou robinetterie.",
            "url": "https://www.plombierwavreurgent.be/services/depannage-urgence",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Debouchage canalisation et WC haute pression",
            "description": "Debouchage mecanique au furet electrique et curage haute pression 200 bars pour WC, evier, sterput, colonne et egout a Wavre.",
            "url": "https://www.plombierwavreurgent.be/services/debouchage",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Recherche de fuite non destructive",
            "description": "Localisation ultra-precise de fuites invisibles par camera thermique, gaz traceur et correlation acoustique avec rapport certifie assurance.",
            "url": "https://www.plombierwavreurgent.be/services/detection-de-fuites",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Chauffage, entretien et depannage chaudieres",
            "description": "Entretien annuel agree Cerga G1/G2, depannage d'urgence chaudiere gaz et mazout, detartrage et remplacement de boiler a Wavre.",
            "url": "https://www.plombierwavreurgent.be/services/chauffage-chaudieres",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Traitement de l'eau et adoucisseur anti-calcaire",
            "description": "Installation, mise en service et entretien d'adoucisseurs d'eau compacts BWT, Durlem et EcoWater adaptes a la durete d'eau de Wavre (38 °fH).",
            "url": "https://www.plombierwavreurgent.be/services/traitement-de-leau",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Installations sanitaires et renovation salle de bain",
            "description": "Pose de WC suspendus Geberit, douches a l'italienne, remplacement de robinetterie Grohe et tuyauterie multicouche garantie 2 ans.",
            "url": "https://www.plombierwavreurgent.be/services/installations-sanitaires",
            "provider": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
          }
        }
      ]
    }
  },
  {
    "@type": "WebSite",
    "@id": "https://www.plombierwavreurgent.be/#website",
    "url": "https://www.plombierwavreurgent.be",
    "name": "Plombier Wavre Urgent",
    "inLanguage": "fr-BE",
    "publisher": { "@id": "https://www.plombierwavreurgent.be/#plumber" }
  }
];

if (pathSegments.length > 0) {
  structuredDataGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonicalUrl}#breadcrumb`,
    "itemListElement": breadcrumbElements
  });
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": structuredDataGraph
};
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_BE" />
    <meta property="og:site_name" content="Plombier Wavre Urgent" />
    <meta property="og:image" content="https://www.plombierwavreurgent.be/logo.png" />

    <!-- Google Fonts Preconnect & Critical Loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" />
    </noscript>

    <!-- Inline Critical CSS for Above-the-Fold Content & Core Web Vitals -->
    <style is:inline>
      :root {
        --font-fallback: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      body {
        margin: 0;
        font-family: 'Inter', var(--font-fallback);
        background-color: #f7f9ff;
        color: #101d29;
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3, h4 {
        font-family: 'Manrope', var(--font-fallback);
      }
      /* Prevent CLS on header and announcement bar */
      .top-announcement-bar {
        min-height: 38px;
        background-color: #123470;
      }
      .site-header {
        min-height: 80px;
        background-color: rgba(255, 255, 255, 0.95);
      }
      /* Fast touch response on mobile */
      button, a, input, select, textarea {
        touch-action: manipulation;
      }
      /* Maintain aspect ratios */
      img, iframe {
        aspect-ratio: attr(width) / attr(height);
      }
      /* Below-the-fold performance boost */
      .content-visibility-auto {
        content-visibility: auto;
        contain-intrinsic-size: 1px 500px;
      }
    </style>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-[#f7f9ff] text-[#101d29] antialiased selection:bg-[#0047ab] selection:text-white pb-24 md:pb-0">
    
    <!-- Top Announcement Bar -->
    <div class="bg-[#123470] text-white text-xs sm:text-sm py-2 px-4 border-b border-white/10">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2">
        <div class="flex items-center flex-wrap gap-2">
          <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-semibold bg-[#059669] text-white animate-pulse">
            En astreinte 24/7
          </span>
          <span class="font-medium">Wavre, Limal, Bierges : Arrivée garantie en moins de 30 minutes</span>
        </div>
        <div class="flex items-center flex-wrap gap-3 text-xs text-white/80">
          <span class="flex items-center gap-1">
            <Icon name="shield" class="w-3.5 h-3.5 text-[#fcd400]" /> Assurance AXA RC 2.5M€
          </span>
          <span class="flex items-center gap-1">
            <Icon name="award" class="w-3.5 h-3.5 text-[#fcd400]" /> 15+ ans d'expérience
          </span>
          <span class="hidden md:flex items-center gap-1">
            <Icon name="check" class="w-3.5 h-3.5 text-[#fcd400]" /> Certifié Cerga Gaz H-39184
          </span>
          <a href="tel:0489865765" class="text-[#fcd400] font-bold hover:underline">
            0489 86 57 65
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#e4eaf1] shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/" class="flex items-center group" aria-label="Plombier Wavre Urgent Accueil">
          <img
            src="/logo.webp"
            alt="Logo Plombier Wavre Urgent"
            class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl object-contain shadow-xs border border-[#e4eaf1] transition-transform group-hover:scale-105"
            width="56"
            height="56"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-3.5 py-2 rounded-lg text-sm font-semibold transition-all ${
                  isActive
                    ? "bg-[#edf4ff] text-[#00327d] font-bold"
                    : "text-[#434653] hover:text-[#00327d] hover:bg-[#f7f9ff]"
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- CTA Header Action -->
        <div class="hidden sm:flex items-center gap-3">
          <a
            href="tel:0489865765"
            class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-xl bg-[#fcd400] hover:bg-[#e9c400] text-[#101d29] font-display font-bold text-sm shadow-sm transition-transform active:scale-95"
          >
            <Icon name="phone" class="w-4 h-4 text-[#00327d]" />
            <span class="tabular-nums">0489 86 57 65</span>
          </a>
        </div>

        <!-- Mobile Menu Trigger -->
        <div class="lg:hidden flex items-center gap-2">
          <a
            href="tel:0489865765"
            class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg bg-[#fcd400] text-[#101d29]"
            aria-label="Appeler le plombier"
          >
            <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
          </a>
          <button
            id="mobile-menu-btn"
            type="button"
            class="p-2 rounded-lg text-[#434653] hover:bg-[#edf4ff] focus:outline-none"
            aria-label="Menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Dropdown Menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-[#e4eaf1] bg-white px-4 py-4 space-y-2 shadow-lg">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="block px-3 py-2.5 rounded-lg text-base font-semibold text-[#101d29] hover:bg-[#edf4ff] hover:text-[#00327d]"
          >
            {item.label}
          </a>
        ))}
        <div class="pt-3 border-t border-[#e4eaf1] flex flex-col gap-2">
          <a
            href="tel:0489865765"
            class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-[#fcd400] text-[#101d29] font-bold text-base shadow-sm"
          >
            <Icon name="phone" class="w-5 h-5 text-[#00327d]" />
            <span>Appel Urgence : 0489 86 57 65</span>
          </a>
          <a
            href="/contact"
            class="w-full inline-flex items-center justify-center gap-2 py-2.5 rounded-xl bg-[#edf4ff] text-[#00327d] font-semibold text-sm"
          >
            Demander un devis gratuit
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Global Contact & Quote Form on Every Page -->
    <ContactFormSection />

    <!-- Global Trust, Guarantees & Certifications Section on Every Page -->
    <TrustGuarantees />

    <!-- Global Google Maps Embed on Every Page -->
    <GoogleMapEmbed />

    <!-- Footer -->
    <footer class="bg-[#123470] text-white pt-16 pb-28 md:pb-12 border-t border-white/10 mt-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-white/10">
          
          <!-- Column 1: Identity & Credentials -->
          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <img
                src="/logo.webp"
                alt="Logo Plombier Wavre Urgent"
                class="w-10 h-10 rounded-lg object-contain shadow-xs border border-white/20"
                width="40"
                height="40"
                loading="lazy"
                decoding="async"
              />
              <span class="font-display font-extrabold text-lg text-white">Plombier Wavre Urgent</span>
            </div>
            <p class="text-sm text-white/80 leading-relaxed">
              Artisan de confiance avec plus de 15 ans d'activité continue à Wavre. Dépannage urgent 24h/24, débouchage haute pression et rénovation sanitaire avec garantie de 2 ans.
            </p>
            <div class="text-xs text-white/70 space-y-1.5 pt-1">
              <p><strong class="text-white">Assurance :</strong> AXA RC Pro & Décennale (Police n° 730.492.180 - Couverture 2.5M€)</p>
              <p>
                <strong class="text-white">Adresse :</strong>
                <a
                  href="https://maps.app.goo.gl/oCBeEPNkZFPVsKrB9"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[#fcd400] hover:underline"
                >
                  Rue Charles Jaumotte 76, 1300 Wavre
                </a>
              </p>
              <p>
                <strong class="text-white">Email :</strong>
                <a
                  href="mailto:contact@plombierwavreurgent.be"
                  class="text-white/90 hover:text-[#fcd400] transition-colors"
                >
                  contact@plombierwavreurgent.be
                </a>
              </p>
              <p>
                <strong class="text-white">Téléphone :</strong>
                <a
                  href="tel:0489865765"
                  class="text-white/90 hover:text-[#fcd400] transition-colors"
                >
                  0489 86 57 65
                </a>
              </p>
              <p><strong class="text-white">Agréments :</strong> Cerga Gaz H-39184, Chauffage G1/G2, VCA, BWT & Durlem</p>
            </div>
          </div>

          <!-- Column 2: Quick Links to Services -->
          <div>
            <h3 class="font-display font-bold text-base text-white uppercase tracking-wider mb-4">
              Prestations Spécialisées
            </h3>
            <ul class="space-y-2 text-sm text-white/80">
              <li><a href="/services/depannage-urgence" class="hover:text-[#fcd400] transition-colors">Dépannage plomberie d'urgence 24h/24</a></li>
              <li><a href="/services/debouchage" class="hover:text-[#fcd400] transition-colors">Débouchage canalisation & WC haute pression</a></li>
              <li><a href="/services/detection-de-fuites" class="hover:text-[#fcd400] transition-colors">Recherche de fuite non destructive</a></li>
              <li><a href="/services/chauffage-chaudieres" class="hover:text-[#fcd400] transition-colors">Entretien & réparation chaudières</a></li>
              <li><a href="/services/traitement-de-leau" class="hover:text-[#fcd400] transition-colors">Adoucisseur d'eau BWT & Durlem</a></li>
              <li><a href="/services/installations-sanitaires" class="hover:text-[#fcd400] transition-colors">Rénovation salle de bain & WC suspendu</a></li>
            </ul>
          </div>

          <!-- Column 3: Local Interventions -->
          <div>
            <h3 class="font-display font-bold text-base text-white uppercase tracking-wider mb-4">
              Zones Couvertes sous 30 min
            </h3>
            <ul class="space-y-2 text-sm text-white/80">
              <li><a href="/locations/limal" class="hover:text-[#fcd400] transition-colors">Limal (1300) - Arrivée en 25 min</a></li>
              <li><a href="/locations/bierges" class="hover:text-[#fcd400] transition-colors">Bierges (1301) - Arrivée en 20 min</a></li>
              <li><a href="/locations/ottignies-louvain-la-neuve" class="hover:text-[#fcd400] transition-colors">Ottignies-LLN (1340/1348) - 25 min</a></li>
              <li><a href="/locations/rixensart" class="hover:text-[#fcd400] transition-colors">Rixensart & Genval (1330/1332) - 25 min</a></li>
              <li><a href="/locations/grez-doiceau" class="hover:text-[#fcd400] transition-colors">Grez-Doiceau (1390) - 25 min</a></li>
              <li><a href="/locations/chaumont-gistoux" class="hover:text-[#fcd400] transition-colors">Chaumont-Gistoux (1325) - 25 min</a></li>
            </ul>
          </div>

          <!-- Column 4: Contact & Emergency -->
          <div class="space-y-4">
            <h3 class="font-display font-bold text-base text-white uppercase tracking-wider mb-2">
              Ligne Directe Dépannage
            </h3>
            <div class="bg-white/10 rounded-xl p-4 border border-white/10">
              <span class="text-xs text-[#fcd400] uppercase font-bold tracking-wider block mb-1">
                Astreinte 24h/24 et 7j/7
              </span>
              <a href="tel:0489865765" class="font-display font-extrabold text-2xl text-white block hover:text-[#fcd400] transition-colors tabular-nums">
                0489 86 57 65
              </a>
              <p class="text-xs text-white/70 mt-1">
                Intervention garantie en moins de 30 minutes. Devis gratuit avant travaux.
              </p>
            </div>
            <div class="space-y-2 text-xs text-white/80">
